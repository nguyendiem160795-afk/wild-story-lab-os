{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildstorylab.dev/schemas/registry.schema.json",
  "title": "Registry Definition",
  "description": "Canonical schema for registries within the AI Agent Operating System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "name",
    "version",
    "status",
    "owner",
    "registry_type",
    "entries",
    "metadata"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "pattern": "^REG-[A-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "deprecated",
        "archived"
      ]
    },
    "owner": {
      "type": "string"
    },
    "registry_type": {
      "type": "string",
      "enum": [
        "agent",
        "workflow",
        "prompt",
        "knowledge",
        "memory",
        "asset",
        "template",
        "service",
        "module",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at",
        "tags"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_registries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}