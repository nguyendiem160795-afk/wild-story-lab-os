{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildstorylab.dev/schemas/validation-report.schema.json",
  "title": "Validation Report Definition",
  "description": "Canonical schema for validation reports generated by the AI Agent Operating System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "asset_id",
    "asset_type",
    "validator",
    "status",
    "summary",
    "results",
    "metadata"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^VAL-[A-Z0-9_-]+$"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "agent",
        "workflow",
        "prompt",
        "knowledge",
        "memory",
        "asset",
        "template",
        "schema",
        "registry",
        "documentation"
      ]
    },
    "validator": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "warning",
        "failed",
        "critical"
      ]
    },
    "summary": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule",
          "severity",
          "status"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "validated_at",
        "version"
      ],
      "properties": {
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "execution_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "review_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}