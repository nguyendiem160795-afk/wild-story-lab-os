{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildstorylab.dev/schemas/knowledge.schema.json",
  "title": "Knowledge Object Definition",
  "description": "Canonical schema for Knowledge Objects in the AI Agent Operating System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "title",
    "version",
    "status",
    "owner",
    "category",
    "content",
    "metadata"
  ],
  "properties": {
    "knowledge_id": {
      "type": "string",
      "pattern": "^KNW-[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "deprecated",
        "archived"
      ]
    },
    "owner": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at",
        "classification"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted",
            "confidential"
          ]
        },
        "review_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  }
}