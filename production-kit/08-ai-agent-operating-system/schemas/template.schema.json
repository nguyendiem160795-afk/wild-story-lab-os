{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildstorylab.dev/schemas/template.schema.json",
  "title": "Template Definition",
  "description": "Canonical schema for reusable templates in the AI Agent Operating System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "name",
    "version",
    "status",
    "owner",
    "template_type",
    "content",
    "metadata"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^TPL-[A-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "deprecated",
        "archived"
      ]
    },
    "owner": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "agent",
        "workflow",
        "prompt",
        "knowledge",
        "memory",
        "documentation",
        "schema",
        "configuration",
        "example",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "default": {},
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "schema_ref": {
          "type": "string"
        },
        "review_required": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at",
        "tags"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}