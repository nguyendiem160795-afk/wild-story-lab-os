{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildstorylab.dev/schemas/prompt.schema.json",
  "title": "Prompt Definition",
  "description": "Canonical schema for production prompt assets in the AI Agent Operating System.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_id",
    "title",
    "version",
    "status",
    "owner",
    "purpose",
    "template",
    "variables",
    "metadata"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^PRM-[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "deprecated",
        "archived"
      ]
    },
    "owner": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "default": {},
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string"
        },
        "schema_ref": {
          "type": "string"
        },
        "validation_required": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "created_at",
        "updated_at",
        "tags"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}